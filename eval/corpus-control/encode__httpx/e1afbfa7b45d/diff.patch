+@contextlib.contextmanager
+def as_network_error(*exception_classes: type) -> typing.Iterator[None]:
+    try:
+        yield
+    except BaseException as exc:
+        for cls in exception_classes:
+            if isinstance(exc, cls):
+                raise NetworkError(exc) from exc
+        raise
